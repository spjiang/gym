# 复制为 .env 后按需修改：cp .env.example .env

# PostgreSQL
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym_dev_password
POSTGRES_DB=gym
DATABASE_URL=postgresql+psycopg://gym:gym_dev_password@postgres:5432/gym

# 后端
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:5174,http://localhost:8081,http://localhost:5175,http://localhost:8082
DEVICE_API_KEY_PEPPER=device-pepper-change-me

# 线上支付：unconfigured | mock | wechat
ONLINE_PAYMENT_MODE=mock
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=
# true=校验凭证后干跑成功；false=需接入正式微信下单 SDK
WECHAT_DRY_RUN=true

# 会员验证码：mock | http | disabled
MEMBER_OTP_MODE=mock
MEMBER_OTP_MOCK_ENABLED=true
MEMBER_OTP_MOCK_CODE=123456
MEMBER_OTP_SMS_URL=
MEMBER_OTP_SMS_TOKEN=

# 会员 H5 公网地址（推广码/获客码/桌码/活动分享等外链；本地 http://localhost:8081，线上 https://m.guanyespace.com）
MEMBER_WEB_PUBLIC_URL=http://localhost:8081

# MinIO（本地 Compose 映射主机 8900；后端容器内用 minio:9000）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=gymminio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_USE_SSL=false
FILE_PUBLIC_BASE_URL=http://localhost:8900/public

# 种子超管（首次启动）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_DISPLAY_NAME=场地超管
# 目录级体验数据（员工/会员/卡种/课程/零售等，幂等）
SEED_DEMO=true

# RabbitMQ（可选 profile）
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
ENABLE_RABBITMQ=false

# 前端（构建时）
VITE_API_BASE_URL=/api/v1
# 会员 H5：Compose 端口 8081（member-web）
# 原生小程序：见 miniprogram/

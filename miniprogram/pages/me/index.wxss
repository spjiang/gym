.me .back-stores {
  font-size: 26rpx;
  color: #f36b21;
  margin-bottom: 16rpx;
}

.me .site {
  font-size: 24rpx;
  color: #7d8389;
  margin-bottom: 24rpx;
}
.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f36b21;
  color: #171b1f;
  font-weight: 700;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar-img {
  width: 96rpx;
  height: 96rpx;
}
.avatar-btn {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #f36b21;
}
.info {
  min-width: 0;
}
.tight {
  margin-bottom: 0;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.pill {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(230, 179, 90, 0.18);
  color: #e6b35a;
}
.pill.ok {
  background: rgba(107, 207, 142, 0.12);
  color: #6bcf8e;
}
.pill.danger {
  background: rgba(240, 113, 120, 0.12);
  color: #f07178;
}
.event {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #343b42;
}
.event-title {
  font-size: 26rpx;
}
.section {
  margin: 24rpx 0 16rpx;
  font-size: 26rpx;
  color: #7d8389;
}
.store {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(243, 107, 33, 0.14);
  color: #f36b21;
  margin-bottom: 8rpx;
}
button.ghost {
  background: transparent !important;
  color: #f2e6d2 !important;
  border: 1rpx solid #343b42 !important;
  margin-top: 24rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f36b21;
  color: #fff;
  font-weight: 700;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar-img {
  width: 96rpx;
  height: 96rpx;
}
.source {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b939c;
}
.info {
  min-width: 0;
}
.tight {
  margin-bottom: 0;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.pill {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(230, 179, 90, 0.18);
  color: #e6b35a;
}
.pill.ok {
  background: rgba(107, 207, 142, 0.12);
  color: #6bcf8e;
}
.pill.danger {
  background: rgba(240, 113, 120, 0.12);
  color: #f07178;
}
.event {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef0f3;
}
.event-title {
  font-size: 26rpx;
}
.group-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 8rpx 12rpx;
}
.group-bar .group-title {
  margin: 0;
}
.more {
  font-size: 24rpx;
  font-weight: 600;
  color: #f36b21;
}
.group-title {
  margin: 28rpx 8rpx 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #8b939c;
}
.menu {
  background: #fff;
  border: 1rpx solid #eef0f3;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 27, 31, 0.04);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2128;
  border-bottom: 1rpx solid #f0f2f4;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item-danger {
  color: #e11d48;
}
.chev {
  color: #c5cad0;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
}
.empty {
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8b939c;
  background: #fff;
  border: 1rpx dashed #d8dce1;
  border-radius: 20rpx;
}
.section {
  margin: 24rpx 0 16rpx;
  font-size: 26rpx;
  color: #7d8389;
}
.order-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #eef0f3;
  border-radius: 20rpx;
  color: #1c2128;
  box-shadow: 0 8rpx 24rpx rgba(23, 27, 31, 0.04);
}
.order-head,
.order-body,
.order-shop {
  display: flex;
  align-items: center;
}
.order-head {
  justify-content: space-between;
  gap: 16rpx;
}
.order-shop {
  min-width: 0;
  flex: 1;
  gap: 8rpx;
}
.order-shop-mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #f36b21;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  flex-shrink: 0;
}
.order-shop-name {
  max-width: 380rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2128;
}
.order-shop-arrow {
  color: #7d8389;
  font-size: 32rpx;
  line-height: 1;
}
.order-hub {
  display: flex;
  margin-bottom: 16rpx;
  padding: 28rpx 8rpx 24rpx;
  background: #fff;
  border: 1rpx solid #eef0f3;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 27, 31, 0.04);
}
.order-hub-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #1c2128;
}
.order-hub-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff4ec;
  color: #f36b21;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}
.order-hub-mark.refund {
  background: #fff1f0;
  color: #b42318;
}
.order-hub-badge {
  position: absolute;
  top: -6rpx;
  right: 18rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #e11d48;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}
.order-status {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #7d8389;
}
.order-status.warn {
  color: #f36b21;
}
.order-status.refund {
  color: #b42318;
}
.order-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}
.order-refund {
  font-size: 22rpx;
  font-weight: 600;
  color: #b42318;
}
.order-body {
  margin-top: 20rpx;
  gap: 16rpx;
  align-items: flex-start;
}
.order-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #fff4ec;
  color: #f36b21;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
  flex-shrink: 0;
}
.order-main {
  min-width: 0;
  flex: 1;
}
.order-goods {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  color: #1c2128;
}
.order-date {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7d8389;
}
.order-price {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #1c2128;
}
.order-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.order-pay {
  padding: 8rpx 24rpx;
  border: 1rpx solid #f36b21;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #f36b21;
}
.store {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(243, 107, 33, 0.14);
  color: #f36b21;
  margin-bottom: 8rpx;
}
button.ghost {
  background: transparent !important;
  color: #1c2128 !important;
  border: 1rpx solid #e0e3e7 !important;
  margin-top: 24rpx;
}
.beian {
  margin: 40rpx 0 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7d8389;
}

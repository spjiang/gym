<view class="wrap me tab-page">
  <view class="card profile">
    <view class="avatar" bindtap="pickAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else>{{avatar}}</text>
    </view>
    <view class="info">
      <view class="name">{{name}}</view>
      <view class="muted tight">{{phoneMasked}}</view>
      <view class="source">来自 {{sourceText}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{showFaceAccess}}">
    <view class="row">
      <text>人脸通行</text>
      <text class="pill {{faceOk ? 'ok' : ''}}">{{faceText}}</text>
    </view>
    <view class="muted tight">人脸采集请到店内 Pad 完成，此处仅展示状态。</view>
    <block wx:if="{{events.length}}">
      <view class="event" wx:for="{{events}}" wx:key="id">
        <view>
          <view class="event-title">门禁点 {{item.access_point_id}}</view>
          <view class="muted tight">
            {{item.timeText}}
            <block wx:if="{{item.reason}}"> · {{item.reason}}</block>
          </view>
        </view>
        <text class="pill {{item.allowed ? 'ok' : 'danger'}}">{{item.allowed ? '放行' : '拒绝'}}</text>
      </view>
    </block>
    <view wx:else class="muted tight">暂无通行记录</view>
  </view>

  <view class="group-title">常用服务</view>
  <view class="menu">
    <view class="menu-item" bindtap="goCatering">
      <text>扫码点餐</text>
      <text class="chev">›</text>
    </view>
    <view class="menu-item" bindtap="goPromotion">
      <text>我的推广</text>
      <text class="chev">›</text>
    </view>
  </view>

  <view class="group-bar">
    <view class="group-title">我的订单</view>
    <view wx:if="{{orderMore}}" class="more" bindtap="goOrders">更多</view>
  </view>
  <view class="order-hub">
    <view class="order-hub-item" bindtap="goOrders" data-status="pending">
      <view class="order-hub-mark">付</view>
      <text>待付款</text>
    </view>
    <view class="order-hub-item" bindtap="goOrders" data-status="paid">
      <view class="order-hub-mark">单</view>
      <text>已支付</text>
    </view>
    <view class="order-hub-item" bindtap="goRefunds">
      <view class="order-hub-mark refund">退</view>
      <text>退款/售后</text>
      <view wx:if="{{refundCount}}" class="order-hub-badge">{{refundCount > 99 ? '99+' : refundCount}}</view>
    </view>
    <view class="order-hub-item" bindtap="goOrders">
      <view class="order-hub-mark">全</view>
      <text>全部订单</text>
    </view>
  </view>
  <view wx:if="{{!orders.length}}" class="empty">暂无订单</view>
  <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="openOrder" data-id="{{item.id}}">
    <view class="order-head">
      <view class="order-shop">
        <view class="order-shop-mark">店</view>
        <text class="order-shop-name">{{item.merchant_name || '门店'}}</text>
        <text class="order-shop-arrow">›</text>
      </view>
      <text class="order-status {{item.statusTone}}">{{item.statusText}}</text>
    </view>
    <view class="order-body">
      <view class="order-thumb">{{item.thumb}}</view>
      <view class="order-main">
        <view class="order-goods">{{item.title}}</view>
        <view class="order-date">{{item.order_no || ''}}</view>
        <view class="order-date">下单：{{item.dateText}}</view>
      </view>
      <view class="order-side">
        <text class="order-price">¥{{item.amountText}}</text>
        <text wx:if="{{item.refundText}}" class="order-refund">{{item.refundText}}</text>
      </view>
    </view>
    <view wx:if="{{item.status === 'pending'}}" class="order-foot">
      <view class="order-pay" catchtap="payOrder" data-id="{{item.id}}">{{payingId === item.id ? '支付中…' : '去支付'}}</view>
    </view>
  </view>

  <view class="group-title">账户</view>
  <view class="menu">
    <view class="menu-item" bindtap="pickAvatar">
      <text>{{uploading ? '头像上传中…' : '更换头像'}}</text>
      <text class="chev">›</text>
    </view>
    <view class="menu-item menu-item-danger" bindtap="logout">
      <text>退出登录</text>
      <text class="chev">›</text>
    </view>
  </view>
  <view class="beian">{{icpBeian}}</view>
</view>
<bottom-nav active="/pages/me/index" />

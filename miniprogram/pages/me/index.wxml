<view class="wrap me tab-page">
  <view class="site">观野SPACE · 会员中心</view>

  <view class="card profile">
    <view class="avatar" bindtap="pickAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else>{{avatar}}</text>
    </view>
    <view class="info">
      <view class="name">{{name}}</view>
      <view class="muted tight">{{phoneMasked}}</view>
      <view class="avatar-btn" bindtap="pickAvatar">{{uploading ? '上传中…' : avatarUrl ? '更换头像' : '上传头像'}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{showFaceAccess}}">
    <view class="row">
      <text>人脸通行</text>
      <text class="pill {{faceOk ? 'ok' : ''}}">{{faceText}}</text>
    </view>
    <view class="muted tight">人脸采集请到店内 Pad 完成，此处仅展示状态。</view>
    <block wx:if="{{events.length}}">
      <view class="event" wx:for="{{events}}" wx:key="id">
        <view>
          <view class="event-title">门禁点 {{item.access_point_id}}</view>
          <view class="muted tight">
            {{item.timeText}}
            <block wx:if="{{item.reason}}"> · {{item.reason}}</block>
          </view>
        </view>
        <text class="pill {{item.allowed ? 'ok' : 'danger'}}">{{item.allowed ? '放行' : '拒绝'}}</text>
      </view>
    </block>
    <view wx:else class="muted tight">暂无通行记录</view>
  </view>

  <view class="card row">
    <text>首次来源</text>
    <text>{{sourceText}}</text>
  </view>

  <view class="section">我的订单</view>
  <view wx:if="{{!orders.length}}" class="muted">暂无订单</view>
  <view class="order-card" wx:for="{{orders}}" wx:key="id">
    <view class="order-head">
      <view class="order-shop">
        <view class="order-shop-mark">店</view>
        <text class="order-shop-name">{{item.merchant_name || '门店'}}</text>
        <text class="order-shop-arrow">›</text>
      </view>
      <text class="order-status">{{item.statusText}}</text>
    </view>
    <view class="order-body">
      <view class="order-thumb">{{item.thumb}}</view>
      <view class="order-main">
        <view class="order-goods">{{item.title}}</view>
        <view class="order-date">下单：{{item.dateText}}</view>
      </view>
      <text class="order-price">¥{{item.amountText}}</text>
    </view>
    <view wx:if="{{item.status === 'pending'}}" class="order-foot">
      <view class="order-pay" catchtap="payOrder" data-id="{{item.id}}">{{payingId === item.id ? '支付中…' : '去支付'}}</view>
    </view>
  </view>

  <button bindtap="goCatering">扫码点餐</button>
  <button bindtap="goPromotion">我的推广</button>
  <button class="ghost" bindtap="logout">退出登录</button>
  <view class="beian">{{icpBeian}}</view>
</view>
<bottom-nav active="/pages/me/index" />

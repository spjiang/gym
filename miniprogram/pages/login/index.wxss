.promoter {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #f36b21;
}
.modes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.mode {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border: 1rpx solid #e6e8eb;
  border-radius: 16rpx;
  background: #fff;
  color: #8b939c;
}
.mode.is-active {
  border-color: #f36b21;
  color: #f36b21;
  background: rgba(243, 107, 33, 0.1);
}
.row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 16rpx;
}
.row input {
  flex: 1;
  margin-bottom: 0;
}
.send-btn {
  flex: none;
  min-width: 140rpx;
  margin: 0;
}
.send-btn[disabled] {
  color: #7d8389;
  background: #eef0f3;
}
.links {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #f36b21;
}
.beian {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7d8389;
}

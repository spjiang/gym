.promoter {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #f36b21;
}
.modes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.mode {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border: 1rpx solid #343b42;
  border-radius: 8rpx;
  color: #7d8389;
}
.mode.is-active {
  border-color: #f36b21;
  color: #f2e6d2;
  background: rgba(243, 107, 33, 0.14);
}
.row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 16rpx;
}
.row input {
  flex: 1;
  margin-bottom: 0;
}
.net-probe {
  margin-top: 32rpx;
  padding: 20rpx;
  border: 1rpx solid #f36b21;
  border-radius: 8rpx;
  background: rgba(243, 107, 33, 0.12);
}
.net-probe-title {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #f36b21;
}
.net-probe-body {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  color: #f2e6d2;
  word-break: break-all;
  white-space: pre-wrap;
}
.net-probe-btn {
  margin-top: 16rpx;
}

<view class="wrap">
  <view wx:if="{{err && !item}}" class="muted">{{err}}</view>
  <block wx:elif="{{item}}">
    <view class="title">{{item.name}}</view>
    <view class="muted">{{item.category || '活动详情'}}</view>
    <image wx:if="{{item.cover_url}}" class="cover" src="{{item.cover_url}}" mode="aspectFill" />
    <view class="card">
      <view class="row"><text>活动时间</text><text>{{timeText}} ～ {{endText}}</text></view>
      <view class="row"><text>报名截止</text><text>{{regEndText}}</text></view>
      <view class="row"><text>地点</text><text>{{item.location || '—'}}</text></view>
      <view class="row"><text>名额</text><text>{{seatsText}}</text></view>
      <view class="row"><text>费用</text><text>{{priceText}}</text></view>
      <view class="row" wx:if="{{item.my_registration_status}}">
        <text>我的报名</text>
        <text>{{statusText}}</text>
      </view>
    </view>
    <view wx:if="{{item.description}}" class="desc">{{item.description}}</view>
    <button wx:if="{{item.my_registration_status === 'pending' && item.my_order_id}}" bindtap="payPending">{{busy ? '处理中' : '去支付'}}</button>
    <button wx:elif="{{item.can_register}}" bindtap="openJoin">{{busy ? '处理中' : payLabel}}</button>
    <button wx:elif="{{item.already_registered}}" disabled>已报名</button>
    <view wx:else class="muted">该活动暂不可报名</view>
    <button
      wx:if="{{item.my_registration_status === 'pending' || item.my_registration_status === 'confirmed'}}"
      class="cancel"
      bindtap="cancel"
    >取消报名</button>
  </block>
  <agreement-confirm
    show="{{agreeShow}}"
    summary="{{agreeSummary}}"
    title="{{agreeTitle}}"
    content="{{agreeContent}}"
    error="{{agreeError}}"
    loading="{{agreeLoading}}"
    confirm-label="{{payLabel}}"
    bind:close="onAgreeClose"
    bind:confirm="onAgreeConfirm"
  />
</view>

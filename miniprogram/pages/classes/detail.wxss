.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #343b42;
  font-size: 28rpx;
}
.row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.row text:first-child {
  color: #7d8389;
}
.link {
  color: #f36b21 !important;
  font-weight: 600;
}

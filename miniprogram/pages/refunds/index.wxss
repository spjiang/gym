.muted,
.err,
.foot {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8b939c;
}

.err {
  color: #f87171;
}

.empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8b939c;
  background: #fff;
  border: 1rpx dashed #d8dce1;
  border-radius: 20rpx;
}

.card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #eef0f3;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 27, 31, 0.04);
}

.head,
.shop,
.body {
  display: flex;
  align-items: center;
}

.head {
  justify-content: space-between;
  gap: 16rpx;
}

.shop {
  min-width: 0;
  gap: 8rpx;
}

.mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #f36b21;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  flex-shrink: 0;
}

.shop-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2128;
}

.status {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #7d8389;
}

.status.warn {
  color: #f36b21;
}

.status.refund {
  color: #b42318;
}

.body {
  margin-top: 20rpx;
  align-items: flex-start;
  gap: 16rpx;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #fff1f0;
  color: #b42318;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
  flex-shrink: 0;
}

.main {
  min-width: 0;
  flex: 1;
}

.goods {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  color: #1c2128;
}

.meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7d8389;
}

.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef0f3;
  font-size: 26rpx;
  color: #7d8389;
}

.amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #b42318;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8b939c;
}

<view class="wrap">
  <view wx:if="{{loading}}" class="muted">加载中…</view>
  <view wx:elif="{{err}}" class="err">{{err}}</view>
  <block wx:else>
    <view wx:if="{{!rows.length}}" class="empty">暂无退款记录</view>
    <view class="card" wx:for="{{rows}}" wx:key="id" bindtap="openOrder" data-id="{{item.order_id}}">
      <view class="head">
        <view class="shop">
          <view class="mark">店</view>
          <text class="shop-name">{{item.merchant_name || '门店'}}</text>
        </view>
        <text class="status {{item.statusTone}}">{{item.statusText}}</text>
      </view>
      <view class="body">
        <view class="thumb">{{item.thumb}}</view>
        <view class="main">
          <view class="goods">{{item.title}}</view>
          <view class="meta">{{item.order_no}}</view>
          <view class="meta" wx:if="{{item.reason}}">{{item.reason}}</view>
        </view>
      </view>
      <view class="amount-row">
        <text>退款金额</text>
        <text class="amount">¥{{item.amountText}}</text>
      </view>
      <view class="meta-row">
        <text>{{item.channelText}}</text>
        <text>{{item.timeLabel}} {{item.timeText}}</text>
      </view>
    </view>
    <view wx:if="{{rows.length && finished}}" class="foot">没有更多了</view>
    <view wx:elif="{{loadingMore}}" class="foot">加载中…</view>
  </block>
</view>

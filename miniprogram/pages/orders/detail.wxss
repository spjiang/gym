.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.shop {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #f36b21;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  flex-shrink: 0;
}
.shop-name {
  font-size: 30rpx;
  font-weight: 700;
}
.status {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #7d8389;
}
.status.warn {
  color: #f36b21;
}
.status.refund {
  color: #b42318;
}
.refund-amount-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #7d8389;
}
.refund-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #b42318;
}
.goods-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #fff4ec;
  color: #f36b21;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
  flex-shrink: 0;
}
.goods-main {
  min-width: 0;
  flex: 1;
}
.goods {
  font-size: 28rpx;
}
.price {
  font-size: 30rpx;
  font-weight: 700;
}
.pay-row {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef0f3;
  font-size: 26rpx;
  color: #7d8389;
}
.pay-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c2128;
}
.block-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
}
.label {
  flex-shrink: 0;
  color: #7d8389;
}
.value {
  text-align: right;
  word-break: break-all;
}

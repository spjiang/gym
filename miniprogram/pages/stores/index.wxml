<view wx:if="{{ready}}" class="portal">
  <view class="hero">
    <block wx:if="{{slides.length}}">
      <image class="hero-bg" src="{{slides[slide]}}" mode="aspectFill"></image>
    </block>
    <view wx:else class="hero-fallback"></view>
    <view class="hero-veil"></view>
    <view class="hero-bar">
      <view class="hero-brand">观野<text class="hero-brand-en">SPACE</text></view>
      <view class="hero-me" bindtap="goMe">我的</view>
    </view>
    <view class="hero-copy">
      <view class="kicker">{{siteName}}</view>
      <view class="hello">你好，{{memberName || '会员'}}</view>
      <view class="tag">{{siteTagline}}</view>
    </view>
    <view wx:if="{{slides.length > 1}}" class="dots">
      <view
        wx:for="{{slides}}"
        wx:for-index="dotIndex"
        wx:key="*this"
        class="dot {{slide == dotIndex ? 'on' : ''}}"
        data-index="{{dotIndex}}"
        bindtap="pickSlide"
      ></view>
    </view>
  </view>

  <view class="body">
    <view wx:if="{{loading}}" class="muted">加载中…</view>
    <view wx:elif="{{err}}" class="muted">{{err}}</view>
    <view wx:else>
      <view class="facts">
        <view
          wx:for="{{facts}}"
          wx:key="key"
          class="fact {{item.wide ? 'wide' : ''}}"
          bindtap="onFactTap"
          data-phone="{{item.phone}}"
          data-address="{{item.address}}"
        >
          <text class="fact-k">{{item.key}}</text>
          <text>{{item.value}}</text>
        </view>
      </view>

      <view wx:if="{{!shops.length}}" class="muted empty">暂无可用门店，请联系门店开通业态。</view>

      <view
        wx:for="{{shops}}"
        wx:for-item="shop"
        wx:key="id"
        class="shop"
        bindtap="enter"
        data-id="{{shop.id}}"
      >
        <view class="shop-thumb">
          <image wx:if="{{shop.coverUrl}}" src="{{shop.coverUrl}}" mode="aspectFill"></image>
          <view wx:else class="shop-wash shop-wash-{{shop.sectionKey}}">{{shop.mark}}</view>
        </view>
        <view class="shop-main">
          <view class="shop-name">{{shop.name}}</view>
          <view class="shop-meta">
            <text class="shop-badge shop-badge-{{shop.sectionKey}}">{{shop.badge}}</text>
            <text wx:if="{{hours}}">{{hours}}</text>
          </view>
          <view class="shop-quote">“{{shop.hint}}”</view>
          <view class="shop-tags">
            <text
              wx:for="{{shop.tags}}"
              wx:for-item="tag"
              wx:key="*this"
              class="chip chip-{{shop.sectionKey}}"
            >{{tag}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{aboutText || gallery.length}}" class="about">
        <view class="sec-head">
          <view class="sec-title">场地介绍</view>
          <view class="sec-sub">{{siteName}}</view>
        </view>
        <view wx:if="{{aboutText}}" class="about-text">{{aboutText}}</view>
        <scroll-view wx:if="{{gallery.length}}" class="gallery" scroll-x enable-flex>
          <view class="gallery-row">
            <image
              wx:for="{{gallery}}"
              wx:key="*this"
              class="gallery-img"
              src="{{item}}"
              mode="aspectFill"
              bindtap="previewGallery"
              data-url="{{item}}"
            ></image>
          </view>
        </scroll-view>
      </view>

      <view class="tip">进入后可随时点顶栏「切换」回到本页</view>
    </view>
  </view>
</view>

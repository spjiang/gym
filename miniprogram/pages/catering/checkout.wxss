.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.price {
  color: #14b8d4;
  font-weight: 700;
  margin-top: 8rpx;
}
.qty {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.qty-n {
  min-width: 36rpx;
  text-align: center;
  font-weight: 700;
}
.seat {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(20, 184, 212, 0.16);
  color: #14b8d4;
  font-weight: 650;
}
.picker {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}
.coupon {
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}
.coupon.on {
  outline: 2rpx solid #14b8d4;
}
.coupon.off {
  opacity: 0.55;
}
.break {
  display: flex;
  justify-content: space-between;
  margin: 8rpx 0;
}
.pay {
  font-weight: 700;
}
.err {
  color: #f07178;
  font-size: 26rpx;
  margin: 12rpx 0;
}
.agree {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin: 24rpx 0;
  font-size: 26rpx;
  color: #7d8389;
}
.box {
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  border: 2rpx solid #4a525a;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.box.on {
  background: #f36b21;
  border-color: #f36b21;
}
.link {
  color: #f36b21;
  font-weight: 650;
}
.mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
}
.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
}
.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #1f2429;
}
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-weight: 700;
}
.body {
  max-height: 70vh;
  font-size: 28rpx;
  line-height: 1.7;
}

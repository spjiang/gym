.lead {
  margin: -4rpx 0 28rpx;
  font-size: 24rpx;
  color: #8b939c;
}

.sec {
  margin: 0 0 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #5c6570;
}

.sec-gap {
  margin-top: 12rpx;
}

.goods {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #eef0f3;
  box-shadow: 0 8rpx 24rpx rgba(23, 27, 31, 0.04);
}

.mark {
  width: 132rpx;
  height: 132rpx;
  flex: none;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff7ec;
  background: linear-gradient(160deg, #f36b21 0%, #c45a1c 48%, #7a3010 100%);
}

.mark-pt {
  background: linear-gradient(160deg, #2dd4bf 0%, #0f8f9a 48%, #134e4a 100%);
}

.mark-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.mark-unit {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  opacity: 0.88;
}

.goods-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.goods-name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.chip {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #f36b21;
  background: rgba(243, 107, 33, 0.16);
}

.meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b939c;
}

.foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}

.price {
  display: flex;
  align-items: baseline;
  color: #f36b21;
}

.price-pt {
  color: #0c8fa3;
}

.yen {
  font-size: 22rpx;
  font-weight: 700;
}

.amount {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.origin {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #a0a7b0;
  text-decoration: line-through;
}

.buy {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #f36b21;
  color: #171b1f;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.buy-pt {
  background: #14b8d4;
}

.empty {
  margin-bottom: 24rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7d8389;
  border: 1rpx dashed #d8dce1;
  border-radius: 16rpx;
}

.head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f36b21;
  color: #171b1f;
  font-weight: 700;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-img {
  width: 112rpx;
  height: 112rpx;
}
.tight {
  margin-bottom: 0;
}
.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #343b42;
  font-size: 28rpx;
}
.row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.row text:first-child {
  color: #7d8389;
  flex-shrink: 0;
}
.gallery {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.gallery image {
  width: 100%;
  height: 220rpx;
  border-radius: 8rpx;
}

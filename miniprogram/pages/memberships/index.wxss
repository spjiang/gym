.lead {
  margin: -4rpx 0 28rpx;
  font-size: 24rpx;
  color: #8b939c;
}

.sec {
  margin: 0 0 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #5c6570;
}

.sec-gap {
  margin-top: 12rpx;
}

.err {
  color: #f87171;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.pass {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #eef0f3;
  box-shadow: 0 8rpx 24rpx rgba(23, 27, 31, 0.04);
}

.pass-dim {
  opacity: 0.72;
}

.mark {
  width: 132rpx;
  height: 132rpx;
  flex: none;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff7ec;
  background: linear-gradient(160deg, #f36b21 0%, #c45a1c 48%, #7a3010 100%);
}

.mark-pt {
  background: linear-gradient(160deg, #2dd4bf 0%, #0f8f9a 48%, #134e4a 100%);
}

.mark-dim {
  background: linear-gradient(160deg, #4a525a, #2a3138);
}

.mark-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.mark-unit {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  opacity: 0.88;
}

.pass-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.pass-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.pass-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b939c;
}

.status {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.status-ok {
  background: rgba(52, 211, 153, 0.14);
  color: #34d399;
}

.status-danger {
  background: rgba(248, 113, 113, 0.14);
  color: #f87171;
}

.status-neutral {
  background: rgba(154, 163, 175, 0.12);
  color: #9aa3af;
}

.empty {
  margin-bottom: 24rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7d8389;
  border: 1rpx dashed #d8dce1;
  border-radius: 16rpx;
}

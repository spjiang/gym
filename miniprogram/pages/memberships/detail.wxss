.back {
  color: #f36b21;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.err {
  color: #f87171;
  font-size: 26rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(243, 107, 33, 0.16);
  color: #f36b21;
}

.status {
  display: inline-flex;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-ok {
  background: rgba(52, 211, 153, 0.14);
  color: #34d399;
}

.status-danger {
  background: rgba(248, 113, 113, 0.14);
  color: #f87171;
}

.status-neutral {
  background: rgba(154, 163, 175, 0.12);
  color: #9aa3af;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7d8389;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #343b42;
  font-size: 28rpx;
}

.row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.label {
  color: #7d8389;
}

.tip {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #7d8389;
}

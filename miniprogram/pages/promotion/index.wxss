.code {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}
.kpis {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.kpi {
  flex: 1;
  background: #22282e;
  border: 1rpx solid #343b42;
  border-radius: 8rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}
.kpi-n {
  font-size: 30rpx;
  font-weight: 700;
}
.tabs {
  display: flex;
  gap: 12rpx;
  margin: 8rpx 0 16rpx;
}
.tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: 1rpx solid #343b42;
  border-radius: 8rpx;
  color: #7d8389;
}
.tab.on {
  border-color: #f36b21;
  color: #f2e6d2;
}
.pending {
  color: #f59e0b;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

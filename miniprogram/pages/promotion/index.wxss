.code {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}
.kpis {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.kpi {
  flex: 1;
  background: #fff;
  border: 1rpx solid #eef0f3;
  box-shadow: 0 8rpx 24rpx rgba(23, 27, 31, 0.04);
  border-radius: 8rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}
.kpi-n {
  font-size: 30rpx;
  font-weight: 700;
}
.tabs {
  display: flex;
  gap: 12rpx;
  margin: 8rpx 0 16rpx;
}
.tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: 1rpx solid #e6e8eb;
  border-radius: 16rpx;
  background: #fff;
  color: #8b939c;
}
.tab.on {
  border-color: #f36b21;
  color: #f36b21;
  background: rgba(243, 107, 33, 0.08);
}
.pending {
  color: #f59e0b;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

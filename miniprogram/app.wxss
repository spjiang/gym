/* 观野浅色：白底 / 墨色文字 / 活力橙 / 电光青 */
page {
  background: #f5f6f8;
  color: #1c2128;
  font-family: 'PingFang SC', 'Noto Sans CJK SC', 'Source Han Sans SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.brand {
  padding: 24rpx 0 32rpx;
}
.brand-word {
  display: flex;
  align-items: flex-end;
}
.brand-word .cn {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #1c2128;
}
.brand-word .en {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-left: 12rpx;
  font-family: Arial, Helvetica, sans-serif;
  color: #1c2128;
}
.brand-tag {
  margin-top: 14rpx;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #8b939c;
}
.brand-bars {
  display: flex;
  align-items: flex-end;
  width: 360rpx;
  margin-top: 16rpx;
}
.bar-orange {
  width: 64%;
  height: 10rpx;
  background: #f36b21;
}
.bar-cyan {
  width: 36%;
  height: 6rpx;
  background: #14b8d4;
}

.wrap {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
  background: #f5f6f8;
}

.tab-page,
.wrap.tab-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c2128;
  margin-bottom: 16rpx;
}
.muted {
  color: #8b939c;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
.card {
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border: 1rpx solid #eef0f3;
  border-radius: 20rpx;
  color: #1c2128;
  box-shadow: 0 8rpx 24rpx rgba(23, 27, 31, 0.04);
}
.card.active {
  border-color: #f36b21;
}
.name {
  font-weight: 700;
  font-size: 30rpx;
  color: #1c2128;
}

input {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  color: #1c2128;
  border: 1rpx solid #e6e8eb;
  border-radius: 16rpx;
}

button {
  background: #f36b21 !important;
  color: #1c2128 !important;
  border: none !important;
  border-radius: 16rpx !important;
  font-weight: 700;
  margin-bottom: 16rpx;
}
button::after {
  border: none !important;
}
button[size='mini'] {
  margin-bottom: 0;
  background: #fff !important;
  color: #1c2128 !important;
  border: 1rpx solid #e0e3e7 !important;
}

/* 观野 VI：炭黑 / 暖白 / 活力橙 / 电光青 */
page {
  background: #171b1f;
  color: #f2e6d2;
  font-family: 'PingFang SC', 'Noto Sans CJK SC', 'Source Han Sans SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.brand {
  padding: 24rpx 0 32rpx;
}
.brand-word {
  display: flex;
  align-items: flex-end;
}
.brand-word .cn {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #f2e6d2;
}
.brand-word .en {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-left: 12rpx;
  font-family: Arial, Helvetica, sans-serif;
  color: #f2e6d2;
}
.brand-tag {
  margin-top: 14rpx;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #f2e6d2;
  opacity: 0.75;
}
.brand-bars {
  display: flex;
  align-items: flex-end;
  width: 360rpx;
  margin-top: 16rpx;
}
.bar-orange {
  width: 64%;
  height: 10rpx;
  background: #f36b21;
}
.bar-cyan {
  width: 36%;
  height: 6rpx;
  background: #14b8d4;
}

.wrap {
  min-height: 100vh;
  padding: 48rpx 40rpx 64rpx;
  box-sizing: border-box;
  background: #171b1f;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #f2e6d2;
  margin-bottom: 16rpx;
}
.muted {
  color: #7d8389;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
.card {
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: #22282e;
  border: 1rpx solid #343b42;
  border-radius: 8rpx;
  color: #f2e6d2;
}
.card.active {
  border-color: #f36b21;
}
.name {
  font-weight: 700;
  font-size: 30rpx;
}

input {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  background: #1f2429;
  color: #f2e6d2;
  border: 1rpx solid #343b42;
  border-radius: 8rpx;
}

button {
  background: #f36b21 !important;
  color: #f2e6d2 !important;
  border: none !important;
  border-radius: 8rpx !important;
  font-weight: 700;
  margin-bottom: 16rpx;
}
button::after {
  border: none !important;
}
button[size='mini'] {
  margin-bottom: 0;
  background: transparent !important;
  color: #f2e6d2 !important;
  border: 1rpx solid #7d8389 !important;
}

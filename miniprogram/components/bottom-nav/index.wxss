.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #1a1f24;
  border-top: 1rpx solid rgba(242, 230, 210, 0.12);
  z-index: 999;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: rgba(242, 230, 210, 0.45);
}

.tab.on {
  color: #f36b21;
  font-weight: 700;
}

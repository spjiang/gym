.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #eef0f3;
  box-shadow: 0 -8rpx 24rpx rgba(23, 27, 31, 0.04);
  z-index: 999;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8b939c;
}

.tab.on {
  color: #f36b21;
  font-weight: 700;
}

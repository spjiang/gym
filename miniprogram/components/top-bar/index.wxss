.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid rgba(242, 230, 210, 0.12);
  background: #1a1f24;
}

.user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f36b21;
  color: #1a1208;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.meta {
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub {
  font-size: 22rpx;
  color: rgba(242, 230, 210, 0.55);
  margin-top: 4rpx;
}

.actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(242, 230, 210, 0.2);
  font-size: 22rpx;
  color: #f2e6d2;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
}
.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
}
.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 80vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #1f2429;
}
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.title {
  font-weight: 700;
  font-size: 32rpx;
}
.cancel {
  color: #7d8389;
  font-size: 26rpx;
}
.summary {
  font-weight: 650;
  margin-bottom: 24rpx;
}
.muted {
  color: #7d8389;
}
.err {
  color: #f07178;
  font-size: 26rpx;
}
.agree {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin: 24rpx 0 32rpx;
  font-size: 26rpx;
  color: #7d8389;
}
.box {
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  border: 2rpx solid #4a525a;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.box.on {
  background: #f36b21;
  border-color: #f36b21;
}
.link {
  color: #f36b21;
  font-weight: 650;
}
.ok {
  background: #f36b21;
  color: #171b1f;
  font-weight: 700;
}
.ok[disabled] {
  opacity: 0.45;
}
.full {
  position: absolute;
  inset: 0;
  z-index: 2;
}
.full-panel {
  max-height: 88vh;
}
.body {
  max-height: 70vh;
  font-size: 28rpx;
  line-height: 1.7;
  color: #f2e6d2;
}

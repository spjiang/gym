# 生产环境 .env 示例（复制到服务器 /home/spjiangl/gym/.env 后修改）
# 部署：docker compose -f docker-compose.prod.yml up -d --build

APP_ENV=production

# 数据库（强密码，勿用默认值）
POSTGRES_USER=gym
POSTGRES_PASSWORD=请替换为强密码
POSTGRES_DB=gym
DATABASE_URL=postgresql+psycopg://gym:请替换为强密码@postgres:5432/gym

# 安全
SECRET_KEY=请替换为长随机字符串
DEVICE_API_KEY_PEPPER=请替换为长随机字符串
JWT_EXPIRE_MINUTES=720

# 域名（见 docs/域名与线上接入设计.md）
CORS_ORIGINS=https://admin.guanyespace.com,https://m.guanyespace.com
MEMBER_WEB_PUBLIC_URL=https://m.guanyespace.com
WECHAT_NOTIFY_URL=https://api.guanyespace.com/api/v1/payment/notify/wechat

# 生产关闭热重载（compose.prod 已设 UVICORN_RELOAD=0，此处可省略）
UVICORN_RELOAD=0

# 生产建议关闭体验数据自动种子（按需）
SEED_DEMO=false
SEED_RESET_DATA=false
SEED_RESET_ROLES=false

# 支付（按实际商户号配置）
ONLINE_PAYMENT_MODE=wechat
WECHAT_DRY_RUN=false
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=

# 会员验证码（生产勿用 mock）
MEMBER_OTP_MODE=http
MEMBER_OTP_MOCK_ENABLED=false

# 超管仅首次部署需要，部署后建议改密
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=请替换为强密码
